---
// A composed page's sections: the document that wins — what the store saved
// (or an editor's draft), else the theme's default for the surface —
// completed with every fixed and required block, each rendered through the
// SDK with one read cache for the page. A preview marks every instance so the
// editor can select it; a shopper's page carries no markers.
//
// The dashboard's Appearance tab can hide a home section and give it its own
// photo without touching the page document: those are theme settings, read
// here once per section. Hero and image-banner draw their picked photo in the
// component; every other section wears it as a backdrop behind its content.
import InstanceView from "@wocart/theme/astro/InstanceView.astro";
import { createReadCache } from "@wocart/theme/astro";
import { resolveSurfaceDocument, type ReadCache, type ThemeDefinition } from "@wocart/theme";
import { homeSectionStateOf, NATIVE_IMAGE_SECTIONS, type HomeSectionType } from "@/theme/runtime/home-sections";
import { renderContext } from "@/theme/runtime/render-context";
import { reportSurface } from "@/theme/pages/surface-report";

interface Props {
  /** The catalog this surface renders from: the route's own, never the full theme. */
  theme: ThemeDefinition;
  surface: string;
  /** What the store saved for the surface (`null` when nothing), or an editor's draft. */
  document: unknown;
  preview?: boolean;
  params?: Readonly<Record<string, string | undefined>>;
  /** The page's read cache, when the route already read what the sections need. */
  reads?: ReadCache;
}

const { theme, surface, document, preview = false, params = {} } = Astro.props;
const store = Astro.locals.store;
const resolved = resolveSurfaceDocument(theme, surface, document, { content: store.content, locales: [store.locale, ...store.fallbackLocales] });
reportSurface(surface, resolved);
const context = renderContext(store, params);
const reads = Astro.props.reads ?? createReadCache();
const views = resolved.page.sections
  .map((section) => ({ section, state: homeSectionStateOf(store, section.type) }))
  .filter(({ state }) => !state.hidden);
---

{views.map(({ section, state }) => {
  const backdrop = state.image && !NATIVE_IMAGE_SECTIONS.has(section.type as HomeSectionType) ? state.image : null;
  const view = (
    <InstanceView instance={section} theme={theme} context={context} storefront={store.client} reads={reads} preview={preview} />
  );
  return backdrop ? (
    <div class="home-section-backdrop" style={`background-image: url('${backdrop.src}'); background-position: ${backdrop.position ?? "center"}`}>
      {view}
    </div>
  ) : (
    view
  );
})}

<style>
  .home-section-backdrop {
    background-repeat: no-repeat;
    background-size: cover;
  }
</style>
